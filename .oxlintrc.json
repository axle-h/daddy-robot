{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "off"
  },
  "overrides": [
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
